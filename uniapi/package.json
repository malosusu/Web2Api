{
  "name": "uniapi-worker",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "deploy": "WRANGLER_LOG_PATH=.wrangler/logs wrangler deploy",
    "dev": "WRANGLER_LOG_PATH=.wrangler/logs wrangler dev",
    "start": "WRANGLER_LOG_PATH=.wrangler/logs wrangler dev",
    "login": "WRANGLER_LOG_PATH=.wrangler/logs wrangler login",
    "logout": "WRANGLER_LOG_PATH=.wrangler/logs wrangler logout",
    "whoami": "WRANGLER_LOG_PATH=.wrangler/logs wrangler whoami",
    "kv:create": "WRANGLER_LOG_PATH=.wrangler/logs wrangler kv namespace create KIMI_KV",
    "typecheck": "tsc --noEmit",
    "deploy:dry": "WRANGLER_LOG_PATH=.wrangler/logs wrangler deploy --dry-run --outdir=.wrangler/tmp"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240512.0",
    "typescript": "^5.4.5",
    "wrangler": "^3.57.0"
  }
}
